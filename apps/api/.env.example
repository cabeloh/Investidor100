# Server
PORT=3001
NODE_ENV=development

# Encryption key for storing cookies (must be exactly 32 hex bytes = 64 chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace_with_64_char_hex_string_here_never_commit_real_key

# Database (SQLite for dev, PostgreSQL for prod)
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/investidor100"

# Scraping schedule (cron syntax, default: every 6 hours)
SCRAPE_SCHEDULE="0 */6 * * *"
